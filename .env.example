# Copy to .dev.vars for local development. Never commit real credentials.
APP_ORIGIN=http://127.0.0.1:5188
DEMO_MODE=true
SSO_ISSUER=http://127.0.0.1:8090
SSO_CLIENT_ID=tournaments-local
SSO_CLIENT_SECRET=replace-with-registered-client-secret
# Atlas is required on Vercel. Leave MONGODB_URI unset for a local SQLite demo.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_DB=tournaments
